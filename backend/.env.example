# --- Server ---
PORT=4000
NODE_ENV=development

# Origin of the Vite frontend. CORS is locked to exactly this value, and
# must match exactly for the session cookie to be sent (credentials mode
# rejects "*").
FRONTEND_ORIGIN=http://localhost:5173

# --- Database (Supabase Postgres, used as a plain Postgres host) ---
# Dashboard > Connect > ORMs / Connection string.
# Pooled connection (port 6543) used by the running server.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432), used by `prisma migrate` only.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
