# Copy this file to .env.local and edit. .env.local is gitignored; this template
# is committed, so add any new variable here too.
#
#   cp .env.example .env.local
#
# Vite only exposes variables prefixed with VITE_. Restart `npm run dev` after
# changing any of them — they are read at server start, not per request.

# ---------------------------------------------------------------------------
# Backend location — the one setting you normally change
# ---------------------------------------------------------------------------
# Include the /api/v1 path, no trailing slash. The app derives both endpoints:
#   {VITE_API_BASE}/results   the whole Dataset
#   {VITE_API_BASE}/auth      /login, /session, /logout
#
# Local backend:
# VITE_API_BASE=http://localhost:8000/api/v1
#
# Deployed backend:
# VITE_API_BASE=https://your-backend.example.com/api/v1
#
# Left unset it falls back to the same origin (/api/v1), which is what you want
# when the backend also serves the built frontend.
VITE_API_BASE=http://localhost:8000/api/v1

# Remember the backend must allow this origin WITH credentials:
#   Access-Control-Allow-Origin: http://localhost:5173   (the exact origin, not *)
#   Access-Control-Allow-Credentials: true
# Otherwise the session cookie is silently never sent. See CLAUDE.md.

# ---------------------------------------------------------------------------
# Overrides — only if results and auth live somewhere unrelated
# ---------------------------------------------------------------------------
# These win over VITE_API_BASE when set.
# VITE_RESULTS_URL=http://localhost:8000/api/v1/results
# VITE_AUTH_URL=http://localhost:8000/api/v1/auth

# ---------------------------------------------------------------------------
# Branding on the sign-in splash
# ---------------------------------------------------------------------------
# VITE_PORTAL_NAME=Teacher Result Portal
# VITE_SCHOOL_NAME=Shaheed Smrity Higher Secondary School
